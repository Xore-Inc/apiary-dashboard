# Environment for the dashboard server. See README.md → "Signing in and security".

# Shared secret with the backend. Required unless APIARY_ALLOW_UNAUTH_DEV=1.
SERVICE_TOKEN=
# Or a file holding it (a swarm secret, e.g. /run/secrets/service-token); set
# one of the two, never both. A trailing newline is dropped. A file that is
# missing or empty refuses to boot (E-SERVICE-TOKEN).
# SERVICE_TOKEN_FILE=

# Optional export-only secret: the VPS job sends it as X-Export-Token to read
# /export/portbridge-manual-blackhole.txt, and it reaches nothing else.
# Must differ from SERVICE_TOKEN (E-EXPORT-TOKEN). Unset turns machine
# access to the export off; a signed-in session still works.
# EXPORT_TOKEN=
# EXPORT_TOKEN_FILE=/run/secrets/export-token   # the file form, instead of the value

# Ed25519 private key the dashboard signs operator identities with
# (x-actor-assertion). The backend holds the public half; its
# ACTOR_ASSERTION_MODE decides whether an unsigned request is refused.
# Give the PEM inline (\n for newlines) or as a file (swarm secret form), not
# both. Unset signs nothing. Generate: openssl genpkey -algorithm ed25519
# ACTOR_ASSERTION_PRIVATE_KEY=
# ACTOR_ASSERTION_PRIVATE_KEY_FILE=/run/secrets/actor-assertion-key

# Base URL of the APIARY backend tier (the canonical BFF's own variable, so
# one deployment configures both). Production requires it. Unset is the
# local-development default and leaves queries answering from the mock.
# BACKEND_URL=http://127.0.0.1:8081

# Same image, the instance with the sandbox/Ghidra/GitHub spool mounts.
# Unset falls back to BACKEND_URL.
# BACKEND_MOUNTED_URL=http://127.0.0.1:8082
# The production Compose file requires both URLs in its host-local .env.
# Set both explicitly, even when one listener serves both paths.

# Per-call timeout (ms), and the bounded queue in front of the backend:
# this many calls in flight, this many more waiting, the rest shed with 503.
# BACKEND_TIMEOUT_MS=30000
# BACKEND_MAX_INFLIGHT=25
# BACKEND_READ_CACHE_TTL_MS=15000
# BACKEND_MAX_QUEUE=50

# Exactly 1 marks a local development instance (bun run dev sets it).
# Never set it on a deployed instance.
# APIARY_ALLOW_UNAUTH_DEV=1

# Exactly 1: the session cookie works over plain HTTP, so a dev server can
# be used by its LAN address. Development only (E-DEV-HTTP-COOKIE).
# APIARY_DEV_HTTP_COOKIE=1

# 1 skips sign-in: everyone is a fixture admin. Development only; the
# server refuses to boot with it otherwise (E-OIDC-DISABLED).
# OIDC_DISABLED=1

# Keycloak realm. Required unless APIARY_ALLOW_UNAUTH_DEV=1 or
# NODE_ENV=development, where the mock identity provider stands in
# (E-OIDC-ISSUER).
# OIDC_ISSUER_URL=https://sso.example.test/realms/apiary
# OIDC_CLIENT_ID=apiary-dashboard
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# Exactly 1: a plain-HTTP issuer (a local Keycloak only).
# OIDC_ALLOW_INSECURE=1

# Redis for sessions (bff:session:, 12 h) and pending sign-ins
# (bff:oidc:pending:, 10 min).
# OIDC_SESSION_REDIS_URL=redis://127.0.0.1:6379/0

# The public origin, when a proxy changes the Host the server sees, and the
# origin Keycloak redirects back to.
# EXTERNAL_URL=https://dashboard.example.test

# Mock only: make the session store and/or the identity provider stop
# answering, to see the outage paths (session-store,identity-provider).
# APIARY_MOCK_FAULTS=session-store

# Concurrent live streams (/api/live) before new ones are shed with 503.
# LIVE_MAX_STREAMS=500

# Event-loop p99 delay (ms) past which admission gates shed new requests.
# BFF_EVENT_LOOP_SHED_MS=250

# File for named events (sign-in outcomes), one JSON line each, for
# Filebeat. Capped at 25 MiB plus one rotated .1 generation. Unset: named
# events are JSON lines on stdout for the container log collector.
# DASHBOARD_BFF_LOG_FILE=/var/log/dashboard/bff.jsonl

# Port of the Bun production server.
PORT=3000
