{
  "name": "apiary-dashboard",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "astryx": {
    "theme": "neutral"
  },
  "scripts": {
    "dev": "APIARY_ALLOW_UNAUTH_DEV=1 APIARY_DEV_HTTP_COOKIE=1 vite dev --port 3009 --host 0.0.0.0",
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "start": "bun run server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "NODE_ENV=test vitest run",
    "typecheck": "tsc --noEmit",
    "studio": "bun design-studio/build.tsx",
    "theme:build": "JITI_TRY_NATIVE=0 bunx --bun astryx theme build --family src/themes/neutral/neutralTheme.ts src/themes/neutral/variants/*.ts --family-key neutral-family --icons-specifier ./icons.tsx && JITI_TRY_NATIVE=0 bunx --bun astryx theme build src/themes/astryx/*/*Theme.ts --icons-specifier ./icons.tsx",
    "theme:check": "JITI_TRY_NATIVE=0 bunx --bun astryx theme build --family src/themes/neutral/neutralTheme.ts src/themes/neutral/variants/*.ts --family-key neutral-family --icons-specifier ./icons.tsx --check && JITI_TRY_NATIVE=0 bunx --bun astryx theme build src/themes/astryx/*/*Theme.ts --icons-specifier ./icons.tsx --check",
    "server-checks": "scripts/server-checks.sh",
    "live": "bun e2e/live/run.ts",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "contract:sync": "bun scripts/sync-backend-contract.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.8",
    "@astryxdesign/theme-neutral": "^0.6.8",
    "@fontsource/albert-sans": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/fustat": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/playwrite-us-trad": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/sarina": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@novnc/novnc": "^1.7.0",
    "@tanstack/query-core": "5.108.2",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cytoscape": "^3.35.0",
    "echarts": "^6.1.0",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.77.0",
    "openid-client": "^6.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.8",
    "@stylexjs/stylex": "^0.19.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "0.8.7",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/react-devtools": "0.10.15",
    "@tanstack/react-router-devtools": "1.167.4",
    "@tanstack/router-cli": "1.168.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/bun": "^1.4.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "patchedDependencies": {
    "@astryxdesign/cli@0.6.8": "patches/@astryxdesign%2Fcli@0.6.8.patch"
  }
}
