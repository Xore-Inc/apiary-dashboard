{
  "name": "apiary-dashboard",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "astryx": {
    "theme": "neutral"
  },
  "scripts": {
    "dev": "APIARY_ALLOW_UNAUTH_DEV=1 APIARY_DEV_HTTP_COOKIE=1 vite dev --port 3009 --host 0.0.0.0",
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "start": "bun run server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "NODE_ENV=test vitest run",
    "typecheck": "tsc --noEmit",
    "studio": "bun design-studio/build.tsx",
    "theme:build": "JITI_TRY_NATIVE=0 bunx --bun astryx theme build --family src/themes/neutral/neutralTheme.ts src/themes/neutral/variants/*.ts --family-key neutral-family --icons-specifier ./icons.tsx && JITI_TRY_NATIVE=0 bunx --bun astryx theme build src/themes/astryx/*/*Theme.ts --icons-specifier ./icons.tsx",
    "theme:check": "JITI_TRY_NATIVE=0 bunx --bun astryx theme build --family src/themes/neutral/neutralTheme.ts src/themes/neutral/variants/*.ts --family-key neutral-family --icons-specifier ./icons.tsx --check && JITI_TRY_NATIVE=0 bunx --bun astryx theme build src/themes/astryx/*/*Theme.ts --icons-specifier ./icons.tsx --check",
    "smoke": "scripts/smoke.sh",
    "crawl": "bun scripts/crawl.ts",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "contract:sync": "bun scripts/sync-backend-contract.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.5",
    "@astryxdesign/theme-neutral": "^0.6.5",
    "@fontsource/albert-sans": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/fustat": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/playwrite-us-trad": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/sarina": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.57",
    "d3-geo": "^3.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.52.0",
    "openid-client": "^6.8.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.5",
    "@stylexjs/stylex": "^0.19.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-cli": "1.167.38",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
